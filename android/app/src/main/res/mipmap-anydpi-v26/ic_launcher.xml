<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8.0+). The launcher masks these two layers
     to whatever shape the device uses — circle, squircle, rounded square — so
     the gradient tile and the trail mark are supplied as separate full-bleed
     layers rather than a pre-masked PNG. Pre-API-26 devices fall back to the
     legacy mipmap-*/ic_launcher.png bitmaps. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
